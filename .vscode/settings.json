{
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  
  // Exclude compiled Helm artifacts and cache files from file watchers & search
  "files.exclude": {
    "**/*.tgz": true,
    "**/charts/": true,
    "**/.DS_Store": true,
    "**/__pycache__": true
  },

  // Specific overrides for YAML and Helm templates to prevent erratic formatting changes
  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },
  "[helm]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },

  // Python formatting setup
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // Kubernetes extension settings
  "vs-kubernetes": {
    "kubectl-path": "kubectl"
  }
}
